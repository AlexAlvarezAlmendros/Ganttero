{
	"name": "backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:migrate": "tsx src/db/migrate.ts up",
		"auth:hash": "tsx src/modules/auth/auth.hash-cli.ts",
		"db:rollback": "tsx src/db/migrate.ts down",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@fastify/multipart": "^10.1.0",
		"@libsql/client": "^0.17.4",
		"fastify": "^5.2.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsx": "^4.23.1",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
