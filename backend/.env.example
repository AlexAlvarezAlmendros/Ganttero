# Ganttero backend — copia a .env y ajusta. .env está en .gitignore.

# development | test | production
NODE_ENV=development

HOST=0.0.0.0
PORT=3000

# libSQL: fichero local en dev; en prod, ruta montada desde el NAS o ws://host:8080 (sqld)
DATABASE_URL=file:./data/ganttero.db

# --- Autenticación (Fase 9): un solo usuario ---------------------------------
# Genera el hash y el secreto con:  pnpm --filter backend auth:hash
# Las tres son OBLIGATORIAS con NODE_ENV=production (el backend no arranca sin ellas).
AUTH_USERNAME=poio
# AUTH_PASSWORD_HASH=scrypt$16384$8$1$<sal>$<hash>   # nunca la contraseña en claro
# AUTH_SECRET=<64 hex>                                # firma la sesión; rotarlo cierra sesiones
# Duración de la sesión en días
AUTH_SESSION_DAYS=30
# Solo `true` si sirves la app por HTTPS: con HTTP el navegador tiraría la cookie
AUTH_COOKIE_SECURE=false

# --- MCP para agentes de IA (Fase 14) ----------------------------------------
# Token bearer del endpoint /api/mcp. SIN ESTA VARIABLE LA RUTA NO EXISTE:
# los agentes se habilitan a mano, nunca por defecto.
# Genera uno con:  openssl rand -hex 32     — NUNCA commitearlo.
# MCP_TOKEN=

# Ollama para la captura por voz (Fase 5) — el del homeserver en prod
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# STT local (Fase 5) — prepara el venv una vez:
#   cd backend/stt && python3 -m venv .venv && .venv/bin/pip install faster-whisper
# Requiere ffmpeg en el host (normaliza el webm del navegador a WAV 16 kHz).
STT_PYTHON=./stt/.venv/bin/python
STT_SCRIPT=./stt/stt.py
STT_MODEL=small

# Audios retenidos (si el ajuste está activo); en prod, ruta del NAS
AUDIO_DIR=./data/audios

# Token de GitHub con scope mínimo (Fase 6). NUNCA commitearlo.
# GITHUB_TOKEN=

# Polling de smart commits (segundos; 0 = off). Elegido polling, no webhook:
# nada de la LAN se expone a Internet.
GITHUB_POLL_SECONDS=300
